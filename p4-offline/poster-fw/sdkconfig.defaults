CONFIG_IDF_TARGET="esp32p4"

# 16 MB flash, custom partition table (matches the stock CS80 layout)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 32 MB PSRAM. P4 modules use HEX (16-line) PSRAM at 200 MHz.
# (200 MHz lives behind IDF_EXPERIMENTAL_FEATURES on 5.4.)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y

# Keep the console on UART0 (H1 header: IO37/IO38). The USB port is reserved
# for the Pi file-transfer protocol, so log lines must NOT go there.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USB_SERIAL_JTAG_ENABLED=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_FREERTOS_HZ=1000
