# LED bring-up firmware for the Lakala / SC7705 mod board (ESP32-P4, N16R32)
#
# Target, flash size and console are pinned here so `idf.py build` needs no
# menuconfig. Adjust only if your board differs.

CONFIG_IDF_TARGET="esp32p4"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_PARTITION_TABLE_SINGLE_APP=y

# UART0 lands on IO37 (TX) / IO38 (RX), which is exactly the H1 debug header.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
